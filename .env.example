# =========================================================================
# OPTIONAL CLOUD / SERVER-SIDE MODE VARIABLES (.env.example)
# =========================================================================
# Основное приложение «Мои финансы» работает по принципу Local-First / Zero-Server:
# для офлайн-веб-версии, GitHub Pages (PWA) и сборки Android .apk (Capacitor)
# эти переменные НЕ требуются.
#
# Задайте их только в том случае, если вы самостоятельно запускаете опциональный
# сервер (`server.ts`) для облачного ИИ-советника или серверной расшифровки аудио.
# =========================================================================

# GEMINI_API_KEY: Optional key for server-side Gemini API fallback (/api/advisor, /api/transcribe).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional public URL when hosted behind server.ts.
APP_URL="MY_APP_URL"

# Optional server-side OpenAI-compatible fallback for /api/advisor when GEMINI_API_KEY is not set:
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
